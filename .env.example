POSTGRES_DB=air_balloon
POSTGRES_USER=air_balloon
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Browser-facing frontend origin. Backend derives its CORS allow-list from
# these values and also permits 127.0.0.1 when FRONTEND_HOST=localhost.
FRONTEND_SCHEME=http
FRONTEND_HOST=localhost
FRONTEND_PORT=5173

# Browser-facing backend port for direct local development and the published
# Docker port. Docker frontend uses same-origin /api and /ws proxies.
BACKEND_PORT=8080

# Optional authoritative comma-separated override. Empty entries are ignored;
# values are trimmed and de-duplicated. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=

SPRING_PROFILES_ACTIVE=demo
# Local demo only. Set a private value before exposing Admin API.
ADMIN_TOKEN=local-demo-admin
# Docker full stack uses the real backend. Set mock only for standalone frontend demos/tests.
VITE_API_MODE=real
# Keep empty for Docker/Nginx same-origin proxying. For direct Vite-to-backend
# development use, for example, http://localhost:8080 (matching BACKEND_PORT).
VITE_API_BASE_URL=
